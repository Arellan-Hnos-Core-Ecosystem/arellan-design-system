{
  "name": "arellan-design-system",
  "private": true,
  "description": "Sistema de diseno compartido — Clinica Automotriz Arellan Hnos",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "publish:ui": "npm run build --filter=@arellan/ui && npm publish --workspace packages/ui",
    "publish:all": "npm run build && npm publish --workspace packages/ui && npm publish --workspace packages/eslint-config && npm publish --workspace packages/typescript-config",
    "version:ui": "npm version --workspace packages/ui",
    "storybook": "turbo run storybook --filter=@arellan/storybook",
    "build-storybook": "turbo run build-storybook --filter=@arellan/storybook"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arellan-tech/arellan-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/arellan-tech/arellan-design-system/issues"
  },
  "homepage": "https://github.com/arellan-tech/arellan-design-system#readme"
}
